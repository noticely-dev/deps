{
  "name": "deps",
  "version": "0.1.0",
  "private": true,
  "description": "Dependency health check for npm projects — deps.noticely.dev",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.10 <25"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "selfcheck": "tsx scripts/selfcheck.ts"
  },
  "dependencies": {
    "@fastify/formbody": "9.0.0",
    "@fastify/multipart": "10.1.2",
    "@fastify/static": "10.1.5",
    "@prometheus-io/client": "0.16.1",
    "eta": "4.6.0",
    "fastify": "5.12.5",
    "mongodb": "7.6.0",
    "secure-json-parse": "4.1.0",
    "semver": "7.8.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.0",
    "@types/semver": "7.8.0",
    "eslint": "10.11.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.2"
  }
}
