<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<% const title = it.title ? it.title + ' · noticely/deps' : 'noticely/deps · dependency health check for npm projects' %>
<% const description = it.description || 'Check a package.json for vulnerable, deprecated and abandoned dependencies. Free report with a prioritised upgrade plan.' %>
<title><%= title %></title>
<meta name="description" content="<%= description %>">
<% if (it.indexable) { %><link rel="canonical" href="<%= it.url %>"><% } else { %><meta name="robots" content="noindex"><% } %>
<meta property="og:type" content="website">
<meta property="og:site_name" content="noticely/deps">
<meta property="og:title" content="<%= title %>">
<meta property="og:description" content="<%= description %>">
<meta property="og:url" content="<%= it.url %>">
<meta property="og:image" content="<%= it.publicUrl %>/static/og.png?v=<%= it.ogV %>">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="noticely/deps: free package.json dependency health check">
<meta name="twitter:card" content="summary_large_image">
<% if (it.refresh) { %><meta http-equiv="refresh" content="<%= it.refresh %>"><% } %>
<link rel="icon" href="/favicon.ico" sizes="48x48">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="stylesheet" href="/static/app.css?v=<%= it.v %>">
<script src="/static/app.js?v=<%= it.v %>" defer></script>
<% if (it.turnstile) { %><script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script><% } %>
</head>
<body>
<header class="nav">
  <a class="logo" href="/"><img src="/static/brand/noticely-mark.svg" alt="" width="26" height="26"><span>noticely<b>/deps</b></span></a>
  <nav>
    <a class="nav-new" href="/">New check</a>
    <a href="/methodology">Methodology</a>
    <a class="gh" href="https://github.com/noticely-dev/deps" aria-label="GitHub" target="_blank" rel="noopener"><svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/></svg><span class="gh-t">GitHub</span></a>
    <button type="button" class="theme-toggle" data-theme-toggle aria-label="Switch light/dark theme" data-tip="Switch light/dark theme" data-tip-end><svg class="i-sun" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="8" cy="8" r="3"/><path d="M8 1.5v1.5M8 13v1.5M1.5 8H3M13 8h1.5M3.4 3.4l1.06 1.06M11.54 11.54l1.06 1.06M3.4 12.6l1.06-1.06M11.54 4.46l1.06-1.06"/></g></svg><svg class="i-moon" width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M13.5 9.6A5.75 5.75 0 0 1 6.4 2.5a5.75 5.75 0 1 0 7.1 7.1Z" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg></button>
  </nav>
</header>
<main class="wrap"><%~ it.body %></main>
<footer class="foot">
  <span>Data: npm registry · OSV.dev · deps.dev / OpenSSF Scorecard</span>
  <a href="/privacy">Privacy</a>
  <span>Reports are deleted after 30 days</span>
  <span>Open source · MIT</span>
</footer>
</body>
</html>
