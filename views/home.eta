<% layout('./layout') %>
<section class="hero">
  <h1>Is your Node.js project aging badly?</h1>
  <p class="lede">Paste or upload your <code>package.json</code> and see which dependencies are <b>vulnerable</b>, <b>deprecated</b>, <b>abandoned</b> or far behind, with a prioritised upgrade plan and effort estimates.</p>
</section>
<form class="panel check-form" method="post" action="/check" enctype="multipart/form-data" data-dropzone>
  <div class="editor" data-editor>
    <div class="editor-head"><label for="packageJson">package.json</label><span class="editor-stats" data-editor-stats></span></div>
    <div class="editor-body">
      <pre class="editor-gutter" aria-hidden="true" data-editor-gutter></pre>
      <div class="editor-stack">
        <pre class="editor-hl" aria-hidden="true"><code data-editor-hl></code></pre>
        <textarea id="packageJson" name="packageJson" rows="14" wrap="off" spellcheck="false" autocapitalize="off" autocomplete="off" placeholder='{&#10;  "name": "my-app",&#10;  "dependencies": {&#10;    "express": "^5.1.0"&#10;  }&#10;}'></textarea>
      </div>
    </div>
  </div>
  <div class="files">
    <div class="file">
      <span class="file-label">…or upload <code>package.json</code></span>
      <div class="file-row">
        <label class="b file-pick"><input type="file" name="packageJsonFile" accept=".json,application/json" title="" data-file>Choose file</label>
        <span class="muted small file-name" data-file-name></span>
      </div>
    </div>
    <div class="file">
      <span class="file-label"><code>package-lock.json</code> <span class="muted">optional, gives exact versions</span></span>
      <div class="file-row">
        <label class="b file-pick"><input type="file" name="lockfile" accept=".json,application/json" title="" data-file>Choose file</label>
        <span class="muted small file-name" data-file-name></span>
      </div>
    </div>
  </div>
  <div class="cf-turnstile" data-sitekey="<%= it.siteKey %>" data-appearance="interaction-only"></div>
  <div class="row-actions">
    <button class="b p" type="submit">Check dependencies</button>
    <a class="b ghost" href="/sample">View sample report</a>
  </div>
  <p class="muted small">5 free checks per day. Only dependency names and versions are stored, for 30 days. Private <code>@scope/…</code> packages are listed but never looked up anywhere except the public npm registry.</p>
</form>
<section class="how">
  <div class="panel"><b>1 · Paste</b><p class="muted">Your <code>package.json</code>, plus the lockfile if you want exact versions.</p></div>
  <div class="panel"><b>2 · Check</b><p class="muted">Each package is checked against npm, OSV.dev and deps.dev for vulnerabilities, deprecation and maintenance.</p></div>
  <div class="panel"><b>3 · Fix</b><p class="muted">Get a health score, a plain-English summary and an upgrade plan ordered by risk removed per hour.</p></div>
</section>
